# Copy this file to ".env" (Windows: copy .env.example .env)

# --- API run directly with Node ("npm run start:local") -------------------
PORT=5000
# MongoDB published on the host by docker-compose.dev.yml (see README, Option B)
MONGO_URI=mongodb://localhost:27017/devops_tasks

# --- Docker Compose host ports (only used by docker compose / run.sh) -------
# The API container talks to MongoDB over the internal network
# (mongodb://mongo:27017/devops_tasks); these only change what is published on your PC.
# API_HOST_PORT=5000
# MONGO_HOST_PORT=27017
